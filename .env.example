# Polymarket
PRIVATE_KEY=0x_your_polymarket_eoa_private_key_here
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# Postgres (Railway)
DATABASE_URL=postgresql://user:pass@host:5432/dbname?schema=fifa

# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change_me_to_a_long_random_string
LOG_LEVEL=info

# Optional: cap auto-execution per strategy (USDC)
MAX_AUTO_STAKE=50
