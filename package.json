{
  "name": "fifa-trader",
  "private": true,
  "workspaces": ["server", "web", "shared"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun --hot ./server/src/index.ts",
    "dev:web": "cd web && bun run dev",
    "build": "cd web && bun run build",
    "start": "NODE_ENV=production bun ./server/src/index.ts",
    "db:generate": "cd server && bun run db:generate",
    "db:push": "cd server && bun run db:push",
    "db:studio": "cd server && bun run db:studio",
    "typecheck": "bun --filter '*' typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
